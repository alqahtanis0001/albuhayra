# Postgres connection string. Neon: copy the POOLED connection string
# (the host containing "-pooler"); keep sslmode=require.
DATABASE_URL="postgresql://user:password@localhost:5432/ledger?schema=public"

# Optional locally. Neon's DIRECT string (host WITHOUT "-pooler"), used only by
# `prisma migrate`. Required on Render, where DATABASE_URL is the pooled string.
# DIRECT_URL=""

# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-at-least-32-random-characters"

# The single ADMIN account created by `npm run seed`. Delete SEED_ADMIN_PASSWORD
# from the environment after the first login and password change.

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-at-least-10-chars"

# Transactional email via Brevo (v1.1e). REST API key from Brevo → SMTP & API → API keys.
BREVO_API_KEY="xkeysib-your-key-here"
# Sender address — must be verified as a sender in Brevo. A Gmail address for
# now (no sender domain yet); swap for an address on your own domain later.
MAIL_FROM="you@example.com"
# Public base URL, used only for the logo image inside emails.
APP_URL="http://localhost:3000"
# v1.2c — secret for GET /api/reminders/run (daily owner digest). Unset → the
# endpoint answers 503 and nothing else is affected. Generate 32+ random chars.
CRON_SECRET=""
