# Postgres connection string. Neon: copy the POOLED connection string
# (the host containing "-pooler"); keep sslmode=require.
DATABASE_URL="postgresql://user:password@localhost:5432/ledger?schema=public"

# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-at-least-32-random-characters"

# The single ADMIN account created by `npm run seed`. Delete SEED_ADMIN_PASSWORD
# from the environment after the first login and password change.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-at-least-10-chars"
