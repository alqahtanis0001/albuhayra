// Schema for سجل المصروفات. Owner: lead (see CLAUDE.md ownership map).
// Money is always an integer in halalas. No VAT, no receipts, no attachments.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
  STAFF
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum Direction {
  IN
  OUT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MADA
  STC_PAY
  OTHER
}

model Establishment {
  id        String   @id @default(cuid())
  name      String
  joinCode  String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users              User[]
  categories         Category[]
  transactions       Transaction[]
  locks              PeriodLock[]
  parties            Party[]
  projects           Project[]
  plans              Plan[]
  instalments        Instalment[]
  // v1.2b
  employees          Employee[]
  employeeAllowances EmployeeAllowance[]
  salaryPeriods      SalaryPeriod[]
  salaryDeductions   SalaryDeduction[]
  attendanceRecords  AttendanceRecord[]
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  /// v1.1e: name split into parts. The defaults exist only so the release
  /// before this one (still running while Render builds) can keep inserting
  /// users; validation requires real values for every new user.
  firstName       String     @default("")
  middleName      String?
  lastName        String     @default("")
  /// v1.1e expand step: the old single-name column, kept (nullable) so the
  /// previous release keeps working until this one is live. Renamed in Prisma
  /// so any leftover `.name` read fails the typecheck. Dropped by a later
  /// contract migration.
  legacyName      String?    @map("name")
  /// Null = not yet verified. Existing users are backfilled as verified.
  emailVerifiedAt DateTime?
  passwordHash    String
  role            Role
  status          UserStatus @default(PENDING)
  canEdit         Boolean    @default(false)
  establishmentId String?
  createdAt       DateTime   @default(now())

  establishment      Establishment?     @relation(fields: [establishmentId], references: [id])
  transactions       Transaction[]
  locks              PeriodLock[]
  auditLogs          AuditLog[]
  emailCodes         EmailCode[]
  // v1.2b
  employee           Employee?          @relation("EmployeeLogin")
  attendanceRecorded AttendanceRecord[] @relation("AttendanceRecorder")
  deductionsCreated  SalaryDeduction[]

  @@index([establishmentId, role, status])
}

enum EmailCodePurpose {
  VERIFY
  RESET
}

/// v1.1e: one-time 6-digit codes, stored only as an HMAC. At most one live
/// (unconsumed) code per user and purpose; a resend replaces it.
model EmailCode {
  id         String           @id @default(cuid())
  userId     String
  purpose    EmailCodePurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int              @default(0)
  sentAt     DateTime         @default(now())
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Category {
  id              String    @id @default(cuid())
  establishmentId String
  nameAr          String
  type            Direction
  active          Boolean   @default(true)
  sortOrder       Int       @default(0)

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  transactions  Transaction[]
  plans         Plan[]
  employees     Employee[]

  @@index([establishmentId, type])
}

model Transaction {
  id              String        @id @default(cuid())
  establishmentId String
  date            DateTime      @db.Date
  direction       Direction
  amountHalalas   Int
  categoryId      String
  paymentMethod   PaymentMethod
  counterparty    String?
  note            String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  /// v1.2a links, all optional; existing rows keep null. Each is validated
  /// against the session's establishment in the action — never trusted.
  partyId         String?
  projectId       String?
  /// The instalment a payment was recorded against. Allocation starts there
  /// and rolls forward (docs/BACKEND.md, v1.2a). Fixed once set.
  instalmentId    String?

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])
  party         Party?        @relation(fields: [partyId], references: [id], onDelete: Restrict)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  instalment    Instalment?   @relation(fields: [instalmentId], references: [id], onDelete: Restrict)

  @@index([establishmentId, date])
  @@index([establishmentId, deletedAt])
  @@index([createdById])
  @@index([categoryId])
  @@index([partyId])
  @@index([projectId])
  @@index([instalmentId])
}

model PeriodLock {
  id              String   @id @default(cuid())
  establishmentId String
  year            Int
  month           Int
  lockedById      String
  lockedAt        DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  lockedBy      User          @relation(fields: [lockedById], references: [id])

  @@unique([establishmentId, year, month])
  @@index([lockedById])
}

model AuditLog {
  id              String   @id @default(cuid())
  establishmentId String?
  userId          String
  action          String
  entity          String
  entityId        String
  before          Json?
  after           Json?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([establishmentId, createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------- v1.2a
// Parties, إضافة (projects), agreements (plans) and their instalments.
// Every model carries establishmentId itself — Instalment included — so the
// scoping gate's top-level rule applies to each without a relation filter.

enum PartyType {
  CUSTOMER
  SUPPLIER
  EMPLOYEE
  OTHER
}

/// الجهات — customers, suppliers, employees and others the establishment
/// deals with. Deactivated, never deleted, once anything references it.
model Party {
  id              String    @id @default(cuid())
  establishmentId String
  name            String
  type            PartyType
  phone           String?
  email           String?
  notes           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  transactions  Transaction[]
  plans         Plan[]
  employee      Employee?

  @@index([establishmentId, type])
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// إضافة (UI label) — an owner-named item with its own costs, e.g. a new
/// branch or a renovation. Not a category: an entry has a category AND may
/// belong to one إضافة.
model Project {
  id              String        @id @default(cuid())
  establishmentId String
  name            String
  description     String?
  /// Optional. Halalas, like every amount.
  budgetHalalas   Int?
  startDate       DateTime      @db.Date
  endDate         DateTime?     @db.Date
  status          ProjectStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  transactions  Transaction[]

  @@index([establishmentId, status])
}

/// Stored state only. The displayed status (قادمة / جارية / مكتملة) is derived
/// from dates and amounts at read time; مؤرشفة and ملغاة are these two.
enum PlanState {
  OPEN
  ARCHIVED
  CANCELLED
}

/// الاتفاقيات — an agreement with one party to pay or be paid a total over a
/// schedule of instalments.
model Plan {
  id              String    @id @default(cuid())
  establishmentId String
  partyId         String
  direction       Direction
  title           String
  totalHalalas    Int
  categoryId      String
  startDate       DateTime  @db.Date
  reminderDays    Int       @default(3)
  state           PlanState @default(OPEN)
  /// When it was archived or cancelled (an instant, Riyadh-formatted on display).
  closedAt        DateTime?
  notes           String?
  /// Optimistic lock: every payment or schedule change bumps it with
  /// `updateMany where revision = n`, so two concurrent payments cannot both
  /// allocate against the same remaining amount.
  revision        Int       @default(0)
  /// v1.2b: SALARY plans are generated and managed from the employee profile
  /// (docs/V12B-DESIGN.md D1); the plan pages cannot edit or cancel them.
  kind            PlanKind  @default(STANDARD)
  employeeId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  party         Party         @relation(fields: [partyId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])
  employee      Employee?     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  instalments   Instalment[]

  @@index([establishmentId, state])
  @@index([partyId])
  @@index([categoryId])
  @@index([employeeId])
}

/// الدفعات. `paidHalalas` is a cache written only by the plan re-allocation
/// (docs/BACKEND.md, v1.2a), recomputed from the linked, non-deleted
/// transactions on every payment create/update/delete and schedule edit.
/// Status is never stored: it depends on "today".
model Instalment {
  id               String   @id @default(cuid())
  establishmentId  String
  planId           String
  /// 1-based display order, renumbered by due date on every schedule save.
  seq              Int
  dueDate          DateTime @db.Date
  amountDueHalalas Int
  paidHalalas      Int      @default(0)
  /// v1.2b: "YYYY-MM" for a SALARY plan's month; null on STANDARD plans.
  /// Unique per plan so generation is idempotent (D2); Postgres allows many nulls.
  periodYm         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  plan          Plan          @relation(fields: [planId], references: [id])
  transactions  Transaction[]
  salaryPeriod  SalaryPeriod?

  @@unique([planId, periodYm])
  @@index([establishmentId, dueDate])
  @@index([planId])
}

// ---------------------------------------------------------------- v1.2b
// Employees, salaries, attendance — docs/V12B-DESIGN.md. Every model carries
// establishmentId. No ID/iqama/IBAN fields (R8; later, only with encryption).

enum PlanKind {
  STANDARD
  SALARY
}

enum EmployeeStatus {
  ACTIVE
  ENDED
}

enum AllowanceType {
  HOUSING
  TRANSPORT
  OTHER
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  REMOTE
  HOLIDAY
}

/// Always exactly one Party of type EMPLOYEE (R1): the name lives there.
model Employee {
  id                 String         @id @default(cuid())
  establishmentId    String
  partyId            String         @unique
  /// Optional STAFF login of the same establishment (R6): grants only
  /// self check-in/out and the employee's own data.
  userId             String?        @unique
  jobTitle           String?
  startDate          DateTime       @db.Date
  endDate            DateTime?      @db.Date
  status             EmployeeStatus @default(ACTIVE)
  notes              String?
  /// Work schedule (R3/R5): bitmask Sun=1, Mon=2, Tue=4, Wed=8, Thu=16,
  /// Fri=32, Sat=64; 31 = Sunday–Thursday. Times are "HH:MM" Riyadh.
  workDays           Int            @default(31)
  workStart          String?
  workEnd            String?
  graceMinutes       Int?
  /// Salary (R3). Null basic = no salary plan.
  basicSalaryHalalas Int?
  /// 1–31, clamped to the month's last day (D3).
  payDay             Int?
  salaryCategoryId   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  establishment  Establishment       @relation(fields: [establishmentId], references: [id])
  party          Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  user           User?               @relation("EmployeeLogin", fields: [userId], references: [id])
  salaryCategory Category?           @relation(fields: [salaryCategoryId], references: [id])
  allowances     EmployeeAllowance[]
  plans          Plan[]
  salaryPeriods  SalaryPeriod[]
  attendance     AttendanceRecord[]

  @@index([establishmentId, status])
}

/// The current allowances (R3). Past months keep theirs in SalaryPeriod (D4).
model EmployeeAllowance {
  id              String        @id @default(cuid())
  establishmentId String
  employeeId      String
  type            AllowanceType
  /// Required for OTHER, shown on the payslip.
  label           String?
  amountHalalas   Int
  createdAt       DateTime      @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

/// One salary month: the snapshot the payslip prints (D4). Its instalment's
/// amountDue = grossHalalas − Σ deductions.
model SalaryPeriod {
  id              String   @id @default(cuid())
  establishmentId String
  employeeId      String
  instalmentId    String   @unique
  periodYm        String
  basicHalalas    Int
  /// [{ type, label, amountHalalas }] as they were for this month.
  allowances      Json
  grossHalalas    Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment     @relation(fields: [establishmentId], references: [id])
  employee      Employee          @relation(fields: [employeeId], references: [id])
  instalment    Instalment        @relation(fields: [instalmentId], references: [id], onDelete: Restrict)
  deductions    SalaryDeduction[]

  @@unique([employeeId, periodYm])
  @@index([establishmentId, periodYm])
}

/// A manual deduction with a reason (D9); reduces the month's instalment.
model SalaryDeduction {
  id              String   @id @default(cuid())
  establishmentId String
  salaryPeriodId  String
  amountHalalas   Int
  reason          String
  createdById     String
  createdAt       DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  salaryPeriod  SalaryPeriod  @relation(fields: [salaryPeriodId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])

  @@index([salaryPeriodId])
}

/// One row per employee per calendar day (D10). Hours are computed at read time.
model AttendanceRecord {
  id               String           @id @default(cuid())
  establishmentId  String
  employeeId       String
  date             DateTime         @db.Date
  status           AttendanceStatus
  /// true once the owner set the status by hand: automatic late never overwrites it.
  statusOverridden Boolean          @default(false)
  checkIn          String?
  checkOut         String?
  note             String?
  recordedById     String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  employee      Employee      @relation(fields: [employeeId], references: [id])
  recordedBy    User          @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  @@unique([employeeId, date])
  @@index([establishmentId, date])
}
