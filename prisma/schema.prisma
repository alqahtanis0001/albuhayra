// Schema for سجل المصروفات. Owner: lead (see CLAUDE.md ownership map).
// Money is always an integer in halalas. No VAT, no receipts, no attachments.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
  STAFF
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum Direction {
  IN
  OUT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MADA
  STC_PAY
  OTHER
}

model Establishment {
  id        String   @id @default(cuid())
  name      String
  joinCode  String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users        User[]
  categories   Category[]
  transactions Transaction[]
  locks        PeriodLock[]
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  /// v1.1e: name split into parts. The defaults exist only so the release
  /// before this one (still running while Render builds) can keep inserting
  /// users; validation requires real values for every new user.
  firstName       String     @default("")
  middleName      String?
  lastName        String     @default("")
  /// v1.1e expand step: the old single-name column, kept (nullable) so the
  /// previous release keeps working until this one is live. Renamed in Prisma
  /// so any leftover `.name` read fails the typecheck. Dropped by a later
  /// contract migration.
  legacyName      String?    @map("name")
  /// Null = not yet verified. Existing users are backfilled as verified.
  emailVerifiedAt DateTime?
  passwordHash    String
  role            Role
  status          UserStatus @default(PENDING)
  canEdit         Boolean    @default(false)
  establishmentId String?
  createdAt       DateTime   @default(now())

  establishment Establishment? @relation(fields: [establishmentId], references: [id])
  transactions  Transaction[]
  locks         PeriodLock[]
  auditLogs     AuditLog[]
  emailCodes    EmailCode[]

  @@index([establishmentId, role, status])
}

enum EmailCodePurpose {
  VERIFY
  RESET
}

/// v1.1e: one-time 6-digit codes, stored only as an HMAC. At most one live
/// (unconsumed) code per user and purpose; a resend replaces it.
model EmailCode {
  id         String           @id @default(cuid())
  userId     String
  purpose    EmailCodePurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int              @default(0)
  sentAt     DateTime         @default(now())
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Category {
  id              String    @id @default(cuid())
  establishmentId String
  nameAr          String
  type            Direction
  active          Boolean   @default(true)
  sortOrder       Int       @default(0)

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  transactions  Transaction[]

  @@index([establishmentId, type])
}

model Transaction {
  id              String        @id @default(cuid())
  establishmentId String
  date            DateTime      @db.Date
  direction       Direction
  amountHalalas   Int
  categoryId      String
  paymentMethod   PaymentMethod
  counterparty    String?
  note            String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])

  @@index([establishmentId, date])
  @@index([establishmentId, deletedAt])
  @@index([createdById])
  @@index([categoryId])
}

model PeriodLock {
  id              String   @id @default(cuid())
  establishmentId String
  year            Int
  month           Int
  lockedById      String
  lockedAt        DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  lockedBy      User          @relation(fields: [lockedById], references: [id])

  @@unique([establishmentId, year, month])
  @@index([lockedById])
}

model AuditLog {
  id              String   @id @default(cuid())
  establishmentId String?
  userId          String
  action          String
  entity          String
  entityId        String
  before          Json?
  after           Json?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([establishmentId, createdAt])
  @@index([userId])
}
